  {
    "id": "fn_latensi",
    "type": "function",
    "z": "tab_phyto",
    "name": "assemble chain",
    "func": "// Breaks the measured time into the links the paper names. Every interval is\n// measured on ONE clock (the node's own), so no cross-device time\n// synchronisation is needed.\nconst d = msg.payload;\nif (!d || typeof d.t_total_us !== 'number') { return null; }\n\nconst ms = (us) => (us / 1000).toFixed(1) + ' ms';\nconst rows = [\n    ['1. Sensor sampling',    ms(d.t_sampling_us), 'fixed firmware interval'],\n    ['2. Transport lag',      'N/A',               'no pipe at beaker scale'],\n    ['3. Network + logic',    ms(d.t_logic_us),    'sample read → command arrives'],\n    ['4. Valve travel',       ms(d.t_valve_us),    'command → limit switch'],\n];\n\nlet html = '<table style=\"width:100%;border-collapse:collapse;font-size:13px\">';\nfor (const [a, b, c] of rows) {\n    html += `<tr><td style=\"padding:4px 0\">${a}<br><span style=\"color:#8A949A;font-size:11px\">${c}</span></td>`;\n    html += `<td style=\"text-align:right;font-weight:600\">${b}</td></tr>`;\n}\nhtml += `<tr><td style=\"padding-top:8px;border-top:1px solid #ccc\"><b>Total measured</b><br>`;\nhtml += `<span style=\"color:#8A949A;font-size:11px\">action: ${d.action}, seq ${d.seq}</span></td>`;\nhtml += `<td style=\"text-align:right;padding-top:8px;border-top:1px solid #ccc;font-size:16px;font-weight:700;color:#17365D\">${ms(d.t_total_us)}</td></tr>`;\nhtml += '</table>';\n\nnode.status({ fill: 'blue', shape: 'dot', text: 'total ' + ms(d.t_total_us) });\nreturn { payload: html };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 510,
    "y": 520,
    "wires": [
      [
        "tmpl_latensi"
      ]
    ]
  },
