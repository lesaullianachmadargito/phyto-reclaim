  {
    "id": "fn_gerbang",
    "type": "function",
    "z": "tab_phyto",
    "name": "stage-gate logic",
    "func": "// TDS envelope threshold from the paper: 4,000 mg/L.\n// Hysteresis stops the valve chattering around the threshold.\nconst THRESHOLD = 4000;\nconst HYSTERESIS = 200;\n\nconst m = msg.payload;\nif (m === null || typeof m.tds !== 'number') { return [null, null]; }\n\nlet state = flow.get('valve') || 'OPEN';\nlet command = null;\n\nif (state === 'OPEN' && m.tds > THRESHOLD) {\n    state = 'CLOSED';\n    command = { seq: m.seq, action: 'CLOSE' };\n} else if (state === 'CLOSED' && m.tds < THRESHOLD - HYSTERESIS) {\n    state = 'OPEN';\n    command = { seq: m.seq, action: 'OPEN' };\n}\nflow.set('valve', state);\n\nnode.status({\n    fill: state === 'OPEN' ? 'green' : 'red',\n    shape: command ? 'dot' : 'ring',\n    text: state + ' — TDS ' + m.tds.toFixed(0) + ' mg/L'\n});\n\nconst status = {\n    payload: state === 'OPEN'\n        ? 'PBR SIDE-STREAM OPEN'\n        : 'PBR SIDE-STREAM CLOSED — TDS outside envelope'\n};\n\nif (!command) { return [null, status]; }\nreturn [{ payload: JSON.stringify(command) }, status];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 540,
    "y": 160,
    "wires": [
      [
        "out_perintah"
      ],
      [
        "txt_gate"
      ]
    ]
  },
