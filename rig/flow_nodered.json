  {
    "id": "fn_pisah",
    "type": "function",
    "z": "tab_phyto",
    "name": "split values",
    "func": "// ui_gauge and ui_chart require msg.payload to be a single NUMBER, not an\n// object. This node splits one telemetry message into four.\nconst m = msg.payload;\nif (!m || typeof m.tds !== 'number') { return [null, null, null, null]; }\nreturn [\n    { payload: m.tds,  topic: 'TDS' },\n    { payload: m.ph,   topic: 'pH' },\n    { payload: m.temp, topic: 'Temperature' },\n    { payload: m.valve }\n];",
    "outputs": 4,
    "timeout": 0,
